{
  "rewrites": [
    {
      "source": "/feedback",
      "destination": "/feedback.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/blackfriday",
      "destination": "/blackfriday.html"
    },
    {
      "source": "/black-friday",
      "destination": "/blackfriday.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
